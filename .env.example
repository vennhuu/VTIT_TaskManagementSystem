# Database Configuration
POSTGRES_DB=taskManagementSystem
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_URL=jdbc:postgresql://localhost:5432/taskManagementSystem
DOCKER_DB_URL=jdbc:postgresql://postgres:5432/taskManagementSystem

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
SHOW_SQL=false

# JWT Secret & Expiration Configuration
JWT_SECRET=your_base64_encoded_jwt_secret_key_here
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# Email Configuration (SMTP)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
DOCKER_REDIS_HOST=redis

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
DOCKER_RABBITMQ_HOST=rabbitmq

# Application Ports
APP_PORT=8080
POSTGRES_PORT=5432